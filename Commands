SELECT
    NOW() AS database_time,
    MAX(computed_at) AS latest_stock_computed,
    MAX(window_end) AS latest_stock_window
FROM fintel_gold.gold_stock_metrics;

SELECT
    NOW() AS database_time,
    MAX(computed_at) AS latest_sentiment_computed,
    MAX(window_end) AS latest_sentiment_window
FROM fintel_gold.gold_sentiment_price;
