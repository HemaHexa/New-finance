
$roots = @(
    "C:\FinTel\news_bronze",
    "C:\FinTel\Market_ticker",
    "C:\FinTel\silver_news"
)

foreach ($root in $roots) {
    Write-Host "`n========== $root ==========" -ForegroundColor Cyan

    Get-ChildItem $root -Force -File |
        Select-Object Name, Length

    Write-Host "`n--- Relevant subfolders ---" -ForegroundColor Yellow

    Get-ChildItem $root -Directory -Recurse -ErrorAction SilentlyContinue |
        Where-Object {
            $_.FullName -notmatch '\\(venv|\.venv|silver_env|__pycache__|site-packages)\\' -and
            $_.FullName -match '\\(data|silver|bronze|output|config|checkpoints|news_by_ticker|stock_silver)'
        } |
        Select-Object -ExpandProperty FullName

    Write-Host "`n--- Python files ---" -ForegroundColor Green

    Get-ChildItem $root -Filter "*.py" -File -Recurse -ErrorAction SilentlyContinue |
        Where-Object {
            $_.FullName -notmatch '\\(venv|\.venv|silver_env|site-packages)\\'
        } |
        Select-Object -ExpandProperty FullName
}
