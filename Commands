python -c "from pyspark.sql import SparkSession; import os; s=SparkSession.builder.appName('FinTelCheckpointTest').master('local[2]').getOrCreate(); d=s.readStream.format('rate').option('rowsPerSecond',5).load(); q=d.writeStream.format('parquet').option('path',os.path.abspath('checkpoint_test/output')).option('checkpointLocation',os.path.abspath('checkpoint_test/checkpoint')).trigger(availableNow=True).start(); q.awaitTermination(); print('CHECKPOINT TEST PASSED'); s.stop()"
