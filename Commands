import re
 
from config.companies import COMPANIES
 
 
# Context words to reduce false matches for short company names
SHORT_NAME_CONTEXT = {
    "TCS": [
        "shares", "stock", "earnings", "revenue",
        "results", "quarter", "company", "services",
        "IT", "market", "profit", "investment"
    ],
    "SBIN": [
        "shares", "stock", "bank", "banking",
        "earnings", "results", "market", "lending"
    ],
    "ITC": [
        "limited", "ltd", "shares", "stock",
        "hotels", "cigarettes", "FMCG", "earnings",
        "results", "market"
    ]
}
 
 
def contains_alias(text, alias):
    pattern = r"(?<!\w)" + re.escape(alias) + r"(?!\w)"
    return re.search(pattern, text, re.IGNORECASE) is not None
 
 
def find_matching_companies(headline, full_text=""):
    text = f"{headline or ''} {full_text or ''}"
    matches = []
 
    for symbol, details in COMPANIES.items():
        for alias in details["aliases"]:
 
            if not contains_alias(text, alias):
                continue
 
            # Apply additional context checks to short aliases
            if alias.upper() in SHORT_NAME_CONTEXT:
                context_words = SHORT_NAME_CONTEXT[alias.upper()]
 
                if not any(
                    contains_alias(text, word)
                    for word in context_words
                ):
                    continue
 
            matches.append(symbol)
            break
 
    return matches
 
 
def is_relevant_article(headline, full_text=""):
    return bool(find_matching_companies(headline, full_text))
