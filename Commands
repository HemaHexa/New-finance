
@echo off
setlocal
cd /d "%~dp0"

if not exist ".venv\Scripts\python.exe" (
    echo .venv not found. Please check your environment.
    pause
    exit /b 1
)

if not defined JAVA_HOME (
    echo JAVA_HOME is not set. Checking Java on PATH...
    java -version
)

for %%D in ("input\silver_news" "input\silver_ticks" "output\gold_joined" "output\gold_windowed" "checkpoints\gold_join" "checkpoints\gold_window") do if not exist "%%~D" mkdir "%%~D"

start "FinTel Mock Silver Upstream" cmd /k ""%CD%\.venv\Scripts\python.exe" "%CD%\mock_upstream.py""

timeout /t 2 /nobreak >nul

start "FinTel Gold Spark" cmd /k ""%CD%\.venv\Scripts\python.exe" "%CD%\gold_stream.py""

timeout /t 12 /nobreak >nul

start "FinTel Streamlit Dashboard" cmd /k ""%CD%\.venv\Scripts\python.exe" -m streamlit run "%CD%\dashboard.py" --server.port 8501"

echo.
echo Demo windows launched.
echo Streamlit URL: http://localhost:8501
echo Keep all three windows open. Press CTRL+C in each to stop.
pause
