
import os
import glob
import pyarrow as pa
import pyarrow.parquet as pq

SOURCE = r"C:\FinTel\silver_news\data\silver\news_by_ticker"
OUTPUT_DIR = r"C:\FinTel\integration\phase3_news_compatible"
OUTPUT_FILE = os.path.join(OUTPUT_DIR, "news_by_ticker.parquet")

os.makedirs(OUTPUT_DIR, exist_ok=True)

files = glob.glob(
    os.path.join(SOURCE, "**", "*.parquet"),
    recursive=True
)

tables = []

for file in files:
    table = pq.read_table(file)

    if table.num_rows == 0:
        print("Skipping empty batch:", file)
        continue

    # Convert nanosecond timestamps to microseconds
    fields = []
    arrays = []

    for field, column in zip(table.schema, table.columns):
        if pa.types.is_timestamp(field.type):
            if field.type.unit == "ns":
                column = column.cast(
                    pa.timestamp("us"),
                    safe=False
                )
                field = pa.field(
                    field.name,
                    pa.timestamp("us"),
                    nullable=field.nullable
                )

        fields.append(field)
        arrays.append(column)

    table = pa.Table.from_arrays(
        arrays,
        schema=pa.schema(fields)
    )

    tables.append(table)
    print("Loaded:", os.path.basename(file), "Rows:", table.num_rows)

# Merge schemas, allowing compatible type promotion
schema = pa.unify_schemas(
    [table.schema for table in tables],
    promote_options="permissive"
)

converted_tables = [
    table.cast(schema, safe=False)
    for table in tables
]

combined = pa.concat_tables(converted_tables)

pq.write_table(combined, OUTPUT_FILE)

print("\nCONVERSION SUCCESSFUL")
print("Total records:", combined.num_rows)
print("Output:", OUTPUT_FILE)
print("\nFinal schema:")
print(combined.schema)
