@'
from pathlib import Path
import json
import pyarrow.parquet as pq

folder = Path("shared_data/bronze/news")
files = sorted(folder.glob("*.parquet"), key=lambda p: p.stat().st_mtime, reverse=True)

if not files:
    print("NO PARQUET FILE FOUND")
    raise SystemExit

file = files[0]
print("\nLATEST PARQUET FILE:", file.name)

table = pq.read_table(file)

print("\n1. PARQUET SCHEMA")
print(table.schema)

print("\n2. COLUMN NAMES")
print(table.column_names)

print("\n3. ROW COUNT")
print(table.num_rows)

if table.num_rows == 0:
    raise SystemExit("Parquet file is empty")

print("\n4. FIRST RECORD")
row = table.slice(0, 1).to_pylist()[0]

for key, value in row.items():
    print(f"{key}: {value}")

print("\n5. RAW JSON VALIDATION")
payload = json.loads(row["raw_json"])

expected = {
    "article_id",
    "published_at",
    "source",
    "headline",
    "full_text",
    "url",
    "ingested_at"
}

print("Actual JSON fields:", set(payload.keys()))
print("Missing fields:", expected - set(payload.keys()))
print("Unexpected fields:", set(payload.keys()) - expected)

print("\n6. REQUIRED FIELD CHECK")
print("article_id present:", bool(payload.get("article_id")))
print("url present:", bool(payload.get("url")))
print("headline or full_text present:", bool(payload.get("headline") or payload.get("full_text")))

print("\n7. KAFKA METADATA CHECK")
print("kafka_key matches article_id:", row["kafka_key"] == payload["article_id"])
print("topic:", row["topic"])
print("partition:", row["partition"])
print("offset:", row["offset"])
print("kafka_ts:", row["kafka_ts"])
