
@echo off
setlocal
cd /d "%~dp0"

echo ==========================================
echo       FINTEL PHASE 4 - GOLD STREAMING
echo ==========================================

REM Configure Python using short Windows path
for %%I in ("%CD%\.venv\Scripts\python.exe") do set "PYTHON_EXE=%%~sI"

set "PYSPARK_PYTHON=%PYTHON_EXE%"
set "PYSPARK_DRIVER_PYTHON=%PYTHON_EXE%"

REM Configure Hadoop - no trailing spaces
set "HADOOP_HOME=C:\hadoop"
set "hadoop.home.dir=C:\hadoop"
set "PATH=C:\hadoop\bin;%PATH%"

echo Python: %PYTHON_EXE%
echo Hadoop: [%HADOOP_HOME%]

if not exist "%PYTHON_EXE%" (
    echo ERROR: Python executable not found.
    pause
    exit /b 1
)

if not exist "C:\hadoop\bin\winutils.exe" (
    echo ERROR: WinUtils not found.
    pause
    exit /b 1
)

echo.
echo Checking Java...
java -version
if errorlevel 1 (
    echo ERROR: Java not available.
    pause
    exit /b 1
)

for %%D in (
    "input\silver_news"
    "input\silver_ticks"
    "output\gold_joined"
    "output\gold_windowed"
    "checkpoints\gold_join"
    "checkpoints\gold_window"
) do (
    if not exist "%%~D" mkdir "%%~D"
)

echo.
echo Starting Mock Silver Upstream...
start "FinTel Mock Silver Upstream" cmd /k ""%PYTHON_EXE%" "%CD%\mock_upstream.py""

timeout /t 2 /nobreak >nul

echo Starting Gold Spark...
start "FinTel Gold Spark" cmd /k ""%PYTHON_EXE%" "%CD%\gold_stream.py""

timeout /t 12 /nobreak >nul

echo Starting Streamlit Dashboard...
start "FinTel Streamlit Dashboard" cmd /k ""%PYTHON_EXE%" -m streamlit run "%CD%\dashboard.py" --server.port 8501"

echo.
echo ==========================================
echo Demo windows launched.
echo Dashboard: http://localhost:8501
echo Keep all three windows open.
echo ==========================================

pause
