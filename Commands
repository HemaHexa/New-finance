
import json
import uuid

from datetime import datetime, timezone
from pathlib import Path

import pyarrow as pa
import pyarrow.parquet as pq

from config.settings import BASE_DIR


BRONZE_NEWS_DIR = (
    BASE_DIR / "shared_data" / "bronze" / "news"
)


class BronzeNewsSink:

    def __init__(self):
        self.output_dir = Path(BRONZE_NEWS_DIR)
        self.output_dir.mkdir(parents=True, exist_ok=True)

    def write_batch(self, messages):
        """
        Write a batch of Kafka news events to Parquet.

        Each Kafka event is preserved in raw_payload.
        """

        if not messages:
            print("[BRONZE] No messages to write.")
            return None

        rows = []

        for message in messages:

            article = message["value"]

            row = {
                "article_id": article.get("article_id"),
                "company_symbol": article.get("company_symbol"),
                "company_name": article.get("company_name"),
                "published_at": article.get("published_at"),
                "ingested_at": article.get("ingested_at"),
                "source": article.get("source"),
                "publisher": article.get("publisher"),
                "headline": (
                    article.get("headline")
                    or article.get("title")
                ),
                "url": (
                    article.get("url")
                    or article.get("link")
                ),
                "raw_payload": json.dumps(
                    article,
                    ensure_ascii=False
                ),
                "kafka_topic": message["topic"],
                "kafka_partition": message["partition"],
                "kafka_offset": message["offset"],
                "kafka_timestamp": message.get("timestamp")
            }

            rows.append(row)

        schema = pa.schema([
            ("article_id", pa.string()),
            ("company_symbol", pa.string()),
            ("company_name", pa.string()),
            ("published_at", pa.string()),
            ("ingested_at", pa.string()),
            ("source", pa.string()),
            ("publisher", pa.string()),
            ("headline", pa.string()),
            ("url", pa.string()),
            ("raw_payload", pa.string()),
            ("kafka_topic", pa.string()),
            ("kafka_partition", pa.int32()),
            ("kafka_offset", pa.int64()),
            ("kafka_timestamp", pa.int64())
        ])

        table = pa.Table.from_pylist(
            rows,
            schema=schema
        )

        timestamp = datetime.now(
            timezone.utc
        ).strftime("%Y%m%dT%H%M%S%fZ")

        filename = (
            f"news_{timestamp}_{uuid.uuid4().hex[:8]}.parquet"
        )

        final_path = self.output_dir / filename
        temporary_path = self.output_dir / f"{filename}.tmp"

        try:

            pq.write_table(
                table,
                temporary_path,
                compression="snappy"
            )

            temporary_path.replace(final_path)

            print("\n========== BRONZE WRITE SUCCESS ==========")
            print(f"Records written : {len(rows)}")
            print(f"File            : {final_path}")
            print("Format          : Parquet")
            print("Compression     : Snappy")
            print("===========================================\n")

            return final_path

        except Exception:
            temporary_path.unlink(missing_ok=True)
            raise
