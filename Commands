# ============================================================
# INCREMENTAL SEARCH
# ============================================================

def fetch_incremental_news(
    checkpoints,
    timeout=20
):
    """
    Search for recent news using each company's checkpoint.

    Only one latest dated candidate per company is returned.
    Old articles are not returned as new events.
    """

    latest_new_articles = []
    successful_symbols = []

    print("\n\n")

    print("#" * 100)
    print("                 FINTEL - INCREMENTAL NEWS SEARCH")
    print("#" * 100)

    for index, (symbol, company) in enumerate(
        COMPANIES.items(),
        start=1
    ):

        print("\n" + "=" * 100)

        print(
            f" COMPANY {index}/{len(COMPANIES)} "
            f": {company['name'].upper()}"
        )

        print("=" * 100)

        checkpoint_value = checkpoints.get(symbol)

        if not checkpoint_value:

            print("STATUS : NO CHECKPOINT - SKIPPED")

            continue

        try:

            checkpoint = datetime.fromisoformat(
                checkpoint_value
            )

            if checkpoint.tzinfo is None:

                checkpoint = checkpoint.replace(
                    tzinfo=timezone.utc
                )

            articles = fetch_google_news_for_company(
                symbol,
                company,
                since=checkpoint,
                timeout=timeout
            )

            overlap_start = checkpoint - timedelta(
                hours=SEARCH_OVERLAP_HOURS
            )

            recent_articles = []

            for article in articles:

                published_at = article.get("published_at")

                if not published_at:
                    continue

                published_datetime = datetime.fromisoformat(
                    published_at
                )

                if published_datetime > overlap_start:

                    recent_articles.append(article)

            # Only one latest article per company.
            sorted_articles = get_latest_dated_articles(
                recent_articles
            )

            successful_symbols.append(symbol)

            print(
                f"Candidates retrieved : {len(articles)}"
            )

            print(
                f"Recent candidates    : {len(recent_articles)}"
            )

            if not sorted_articles:

                print("\nSTATUS : NO NEW NEWS")
                print("Existing latest-news record remains unchanged.")

                continue

            latest_article = sorted_articles[0]

            latest_new_articles.append(latest_article)

            print("\nNEW LATEST ARTICLE")
            print("-" * 100)

            print(
                f"Company   : {company['name']}"
            )

            print(
                f"Headline  : {latest_article.get('title', 'N/A')}"
            )

            print(
                f"Publisher : {latest_article.get('publisher', 'Unknown')}"
            )

            print(
                f"Published : {latest_article.get('published', 'N/A')}"
            )

            print(
                f"Link      : {latest_article.get('link', 'N/A')}"
            )

            print("\nSTATUS : NEW ARTICLE FOUND")

        except requests.RequestException as error:

            print(f"STATUS : REQUEST FAILED - {error}")

    print("\n\n")

    print("#" * 100)
    print("                 INCREMENTAL SEARCH SUMMARY")
    print("#" * 100)

    print(f"Companies Configured : {len(COMPANIES)}")
    print(f"Successful Searches  : {len(successful_symbols)}")
    print(f"New Latest Articles  : {len(latest_new_articles)}")

    print("#" * 100)

    return latest_new_articles, successful_symbols
