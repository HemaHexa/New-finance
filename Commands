
$env:HADOOP_HOME = "C:\hadoop"
$env:PATH = "C:\hadoop\bin;$env:PATH"

$python = "C:\FinTel\Market_ticker\silver_env\Scripts\python.exe"

@'
import os
from pyspark.sql import SparkSession

os.environ["HADOOP_HOME"] = r"C:\hadoop"

spark = (
    SparkSession.builder
    .appName("FinTel-Integration-Schema-Check")
    .master("local[2]")
    .getOrCreate()
)

spark.sparkContext.setLogLevel("ERROR")

stock_path = r"C:\FinTel\Market_ticker\silver\data\stock_silver"
news_path = r"C:\FinTel\silver_news\data\silver\news_by_ticker"

print("\n========== PHASE 2 STOCK SILVER SCHEMA ==========")
stock = spark.read.option("mergeSchema", "true").parquet(stock_path)
stock.printSchema()
print("\nSTOCK SAMPLE:")
stock.show(5, truncate=False)

print("\n========== PHASE 3 NEWS BY TICKER SCHEMA ==========")
news = spark.read.option("mergeSchema", "true").parquet(news_path)
news.printSchema()
print("\nNEWS SAMPLE:")
news.show(5, truncate=False)

print("\n========== COLUMN MAPPING ==========")
print("STOCK COLUMNS:", stock.columns)
print("NEWS COLUMNS:", news.columns)

spark.stop()
'@ | & $python -

