
import os
from pyspark.sql import SparkSession
from delta import configure_spark_with_delta_pip

os.environ["HADOOP_HOME"] = r"C:\hadoop"

builder = (
    SparkSession.builder
    .appName("FinTel-Gold-Input-Test")
    .master("local[2]")
    .config(
        "spark.sql.extensions",
        "io.delta.sql.DeltaSparkSessionExtension"
    )
    .config(
        "spark.sql.catalog.spark_catalog",
        "org.apache.spark.sql.delta.catalog.DeltaCatalog"
    )
)

spark = configure_spark_with_delta_pip(builder).getOrCreate()
spark.sparkContext.setLogLevel("ERROR")

stock_path = r"C:\FinTel\Market_ticker\silver\data\stock_silver"
news_path = r"C:\FinTel\integration\phase3_news_compatible\news_by_ticker.parquet"

try:
    print("\n========== PHASE 2: STOCK DELTA ==========")
    stock = spark.read.format("delta").load(stock_path)

    stock.printSchema()
    print("Stock rows:", stock.count())
    stock.select(
        "symbol", "current_price", "change_percent",
        "market_timestamp"
    ).show(5, truncate=False)

    print("\n========== PHASE 3: NEWS PARQUET ==========")
    news = spark.read.parquet(news_path)

    news.printSchema()
    print("News rows:", news.count())
    news.select(
        "ticker", "sentiment", "sentiment_score",
        "published_at", "kafka_ts"
    ).show(5, truncate=False)

    print("\n========== JOIN KEY CHECK ==========")
    stock_symbols = stock.select("symbol").distinct()
    news_tickers = news.select("ticker").distinct()

    print("Stock symbols:")
    stock_symbols.show(30, truncate=False)

    print("News tickers:")
    news_tickers.show(30, truncate=False)

    matches = (
        news.join(
            stock,
            news.ticker == stock.symbol,
            "inner"
        )
    )

    print("Matching news-stock rows:", matches.count())

    print("\nINPUT TEST COMPLETED")

finally:
    spark.stop()
