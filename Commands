import requests
import feedparser
import truststore
 
from config.companies import COMPANIES
from config.rss_sources import RSS_FEEDS
 
 
# SSL configuration
truststore.inject_into_ssl()
 
 
# Financial news topics
FINANCIAL_NEWS_TERMS = (
    'earnings OR revenue OR profit OR "financial results" '
    'OR acquisition OR contract OR expansion OR investment '
    'OR dividend OR fundraising OR regulatory OR order '
    'OR partnership OR merger OR debt OR "market share"'
)
 
 
# Google News HTTP headers
HEADERS = {
    "User-Agent": "FinTel-NewsPipeline/1.0"
}
 
 
def fetch_feed(url, timeout=20):
    """Fetch and parse a standard RSS feed."""
 
    response = requests.get(
        url,
        headers=HEADERS,
        timeout=timeout
    )
 
    response.raise_for_status()
 
    return feedparser.parse(response.content).entries
 
 
def get_google_news_config():
    """Return enabled Google News RSS configuration."""
 
    for source in RSS_FEEDS:
        if (
            source["source"] == "Google News RSS"
            and source["enabled"]
        ):
            return source
 
    raise ValueError("Google News RSS is not enabled.")
 
 
def build_company_query(symbol, company):
    """Build a targeted financial news query."""
 
    company_name = company["name"]
 
    # Avoid ambiguous short company names.
    if symbol == "ITC":
        company_query = '"ITC Limited" OR "ITC Ltd"'
    else:
        company_query = f'"{company_name}"'
 
    return (
        f'({company_query}) '
        f'({FINANCIAL_NEWS_TERMS})'
    )
 
 
def fetch_google_news_for_company(
    symbol,
    company,
    timeout=20
):
    """Fetch Google News RSS articles for one company."""
 
    source_config = get_google_news_config()
 
    query = build_company_query(symbol, company)
 
    params = {
        "q": query,
        "hl": "en-IN",
        "gl": "IN",
        "ceid": "IN:en"
    }
 
    response = requests.get(
        source_config["url"],
        params=params,
        headers=HEADERS,
        timeout=timeout
    )
 
    response.raise_for_status()
 
    parsed_feed = feedparser.parse(response.content)
 
    articles = []
 
    for entry in parsed_feed.entries:
 
        article = dict(entry)
 
        article["retrieved_via"] = "Google News RSS"
 
        publisher = entry.get("source", {})
 
        article["publisher"] = (
            publisher.get("title", "Unknown")
            if isinstance(publisher, dict)
            else "Unknown"
        )
 
        article["company_symbol"] = symbol
        article["company_name"] = company["name"]
        article["search_query"] = query
 
        articles.append(article)
 
    return articles
 
 
def fetch_all_google_news(timeout=20):
    """
    Fetch targeted news for all companies.
    Select and display the latest dated article per company.
    """
 
    latest_articles = []
 
    print("\n")
    print("=" * 75)
    print("                 FINTEL NEWS INGESTION")
    print("=" * 75)
 
    for symbol, company in COMPANIES.items():
 
        try:
 
            articles = fetch_google_news_for_company(
                symbol,
                company,
                timeout
            )
 
            # Keep only articles with publication dates.
            valid_articles = [
                article
                for article in articles
                if article.get("published_parsed")
            ]
 
            # Sort newest to oldest.
            valid_articles.sort(
                key=lambda article: article["published_parsed"],
                reverse=True
            )
 
            if not valid_articles:
 
                print("\n" + "-" * 75)
                print(f"COMPANY : {company['name']}")
                print("STATUS  : No dated news found")
 
                continue
 
            # Select one latest article.
            latest_article = valid_articles[0]
 
            latest_articles.append(latest_article)
 
            print("\n" + "-" * 75)
            print(f"COMPANY       : {company['name']}")
            print(f"SYMBOL        : {symbol}")
            print(f"HEADLINE      : {latest_article.get('title', 'N/A')}")
            print(f"PUBLISHER     : {latest_article.get('publisher', 'Unknown')}")
            print(f"RETRIEVED VIA : {latest_article.get('retrieved_via')}")
            print(f"PUBLISHED     : {latest_article.get('published', 'N/A')}")
            print(f"LINK          : {latest_article.get('link', 'N/A')}")
 
        except requests.RequestException as error:
 
            print("\n" + "-" * 75)
            print(f"COMPANY : {company['name']}")
            print(f"STATUS  : Request failed - {error}")
 
    # Final summary
    print("\n")
    print("=" * 75)
    print("                    INGESTION SUMMARY")
    print("=" * 75)
 
    print(f"Companies configured : {len(COMPANIES)}")
    print(f"Companies checked    : {len(COMPANIES)}")
    print(f"Latest articles      : {len(latest_articles)}")
    print(
        f"Companies without news: "
        f"{len(COMPANIES) - len(latest_articles)}"
    )
 
    print("Active retrieval source: Google News RSS")
 
    print("=" * 75)
 
    return latest_articles



import time
from datetime import datetime, timezone
 
from config.rss_sources import RSS_FEEDS
from config.settings import (
    RSS_POLL_INTERVAL_SECONDS,
    HTTP_TIMEOUT_SECONDS
)
 
from producers.news.rss_fetcher import fetch_feed
from producers.news.rss_parser import parse_article
from producers.news.company_filter import find_matching_companies
from producers.news.article_identity import generate_article_id
from producers.news.deduplicator import (
    initialize_database,
    is_article_seen,
    mark_article_published
)
from producers.news.kafka_publisher import NewsKafkaPublisher
from producers.news.buffer_manager import BufferManager
from producers.news.metrics import NewsMetrics
 
 
class NewsProducer:
 
    def __init__(self):
        initialize_database()
 
        self.kafka = NewsKafkaPublisher()
        self.buffer = BufferManager()
        self.metrics = NewsMetrics()
 
    def publish_article(self, article):
        """Publish to Kafka and mark only after acknowledgement."""
 
        success = self.kafka.publish(article)
 
        if success:
            mark_article_published(article["article_id"])
            self.metrics.increment("kafka_published")
            return True
 
        self.buffer.save(article)
        self.metrics.increment("buffered_articles")
        return False
 
    def replay_buffer(self):
        """Replay pending articles in order."""
 
        pending = self.buffer.get_pending()
 
        for file_path, article in pending:
            if is_article_seen(article["article_id"]):
                self.buffer.remove(file_path)
                continue
 
            if self.kafka.publish(article):
                mark_article_published(article["article_id"])
                self.buffer.remove(file_path)
                self.metrics.increment("buffer_replayed")
            else:
                # Preserve order: stop if Kafka is unavailable.
                break
 
    def process_feed(self, feed):
        source = feed["source"]
        start_time = time.time()
 
        try:
            entries = fetch_feed(
                feed["url"],
                timeout=HTTP_TIMEOUT_SECONDS
            )
 
            self.metrics.record_feed_fetch(
                source,
                time.time() - start_time,
                "success"
            )
 
            self.metrics.increment(
                "articles_discovered", len(entries)
            )
 
            for entry in entries:
                parsed = parse_article(entry, source)
 
                if not parsed["url"]:
                    self.metrics.increment("articles_rejected")
                    continue
 
                matching_companies = find_matching_companies(
                    parsed["headline"],
                    parsed["full_text"]
                )
 
                if not matching_companies:
                    self.metrics.increment("articles_rejected")
                    continue
 
                article_id = generate_article_id(
                    parsed["guid"],
                    parsed["url"]
                )
 
                if is_article_seen(article_id):
                    self.metrics.increment("duplicates_skipped")
                    continue
 
                article = {
                    "article_id": article_id,
                    "published_at": parsed["published_at"],
                    "source": parsed["source"],
                    "headline": parsed["headline"],
                    "full_text": parsed["full_text"],
                    "url": parsed["url"],
                    "ingested_at": datetime.now(
                        timezone.utc
                    ).isoformat().replace("+00:00", "Z")
                }
 
                self.metrics.increment("relevant_articles")
                self.publish_article(article)
 
        except Exception as error:
            self.metrics.record_feed_fetch(
                source,
                time.time() - start_time,
                "failed"
            )
            print(f"[ERROR] {source}: {error}")
 
    def run(self):
        print("FinTel News Producer started.")
 
        try:
            while True:
                print("\nChecking pending buffer...")
                self.replay_buffer()
 
                for feed in RSS_FEEDS:
                    if feed["enabled"]:
                        self.process_feed(feed)
 
                self.metrics.report()
 
                print(
                    f"Next RSS check in "
                    f"{RSS_POLL_INTERVAL_SECONDS} seconds."
                )
 
                time.sleep(RSS_POLL_INTERVAL_SECONDS)
 
        except KeyboardInterrupt:
            print("\nStopping FinTel News Producer...")
 
        finally:
            self.kafka.close()
 
 
if __name__ == "__main__":
    producer = NewsProducer()
    producer.run()


