
import json
import time

from kafka import KafkaConsumer
from kafka.errors import KafkaError

from config.settings import (
    KAFKA_BOOTSTRAP_SERVERS,
    NEWS_TOPIC
)

from spark_jobs.bronze_news_sink import BronzeNewsSink


class NewsConsumer:

    def __init__(self):

        self.consumer = KafkaConsumer(
            NEWS_TOPIC,
            bootstrap_servers=KAFKA_BOOTSTRAP_SERVERS.split(","),
            group_id="fintel-bronze-news-consumer",

            # Commit offsets only after successful Parquet write.
            enable_auto_commit=False,

            auto_offset_reset="earliest",

            # Decode Kafka JSON messages.
            value_deserializer=lambda value: json.loads(
                value.decode("utf-8")
            ),

            key_deserializer=lambda key: (
                key.decode("utf-8") if key else None
            ),

            consumer_timeout_ms=1000
        )

        self.bronze_sink = BronzeNewsSink()

        print("\nFinTel Bronze News Consumer started.")
        print(f"Kafka topic : {NEWS_TOPIC}")
        print("Consumer group: fintel-bronze-news-consumer")

    def process_messages(self):

        records = self.consumer.poll(
            timeout_ms=5000,
            max_records=100
        )

        messages = []

        for topic_partition, records_list in records.items():

            for record in records_list:

                messages.append({
                    "value": record.value,
                    "topic": record.topic,
                    "partition": record.partition,
                    "offset": record.offset,
                    "timestamp": record.timestamp
                })

        if not messages:
            return 0

        print(f"\nReceived {len(messages)} Kafka messages.")

        # Write the complete batch before committing offsets.
        output_file = self.bronze_sink.write_batch(messages)

        if output_file:

            # Commit only after successful Bronze storage.
            self.consumer.commit()

            print(
                f"[KAFKA] Committed offsets for "
                f"{len(messages)} messages."
            )

            return len(messages)

        return 0

    def run(self):

        print("\nWaiting for Kafka messages...")

        try:

            while True:

                try:
                    self.process_messages()

                except KafkaError as error:
                    print(f"[KAFKA ERROR] {error}")
                    time.sleep(3)

                except Exception as error:
                    print(f"[CONSUMER ERROR] {error}")
                    time.sleep(3)

        except KeyboardInterrupt:
            print("\nStopping Bronze News Consumer...")

        finally:
            self.consumer.close()
            print("Kafka consumer closed.")


if __name__ == "__main__":

    consumer = NewsConsumer()
    consumer.run()
