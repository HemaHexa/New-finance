
from __future__ import annotations

import json
from pathlib import Path

import pandas as pd
import streamlit as st
from streamlit_autorefresh import st_autorefresh


# ---------------------------------------------------------
# PATHS
# ---------------------------------------------------------

ROOT = Path(__file__).resolve().parent

JOINED_DIR = ROOT / "output" / "gold_joined_latest_news"
WINDOW_DIR = ROOT / "output" / "gold_windowed_latest_news"

NEWS_DIR = ROOT / "input" / "silver_news"
TICKS_DIR = ROOT / "input" / "silver_ticks"


# ---------------------------------------------------------
# PAGE CONFIGURATION
# ---------------------------------------------------------

st.set_page_config(
    page_title="FinTel | Gold Streaming",
    page_icon="📈",
    layout="wide"
)

st.title("FinTel — Real-Time Market Intelligence")

st.caption(
    "Latest News Carry-Forward · Stock Price Monitoring · "
    "FinBERT Sentiment · Gold Streaming"
)

st.info(
    "Dashboard refreshes every 1 minute. Each company displays "
    "its latest available stock tick and latest available news "
    "sentiment. Sentiment is reused until a newer article arrives."
)


# ---------------------------------------------------------
# READ JSON FILES
# ---------------------------------------------------------

def read_json_dir(folder: Path) -> pd.DataFrame:

    paths = sorted(folder.rglob("part-*.json")) if folder.exists() else []

    frames = []

    for path in paths:
        try:
            if path.stat().st_size:
                frames.append(pd.read_json(path, lines=True))
        except (ValueError, OSError, json.JSONDecodeError):
            continue

    if not frames:
        return pd.DataFrame()

    return pd.concat(frames, ignore_index=True)


def count_json_events(folder: Path) -> int:

    paths = folder.rglob("part-*.json") if folder.exists() else []
    count = 0

    for path in paths:
        try:
            if path.stat().st_size:
                count += len(
                    path.read_text(encoding="utf-8").splitlines()
                )
        except OSError:
            continue

    return count


# ---------------------------------------------------------
# LOAD DATA
# ---------------------------------------------------------

joined = read_json_dir(JOINED_DIR)
windowed = read_json_dir(WINDOW_DIR)

news_count = count_json_events(NEWS_DIR)
tick_count = count_json_events(TICKS_DIR)


# ---------------------------------------------------------
# PREPARE TIMESTAMPS
# ---------------------------------------------------------

for column in [
    "market_event_time",
    "news_event_timestamp",
    "news_state_timestamp",
    "window_start",
    "window_end"
]:
    for frame in [joined, windowed]:
        if column in frame.columns:
            frame[column] = pd.to_datetime(
                frame[column],
                errors="coerce",
                utc=True
            )


# ---------------------------------------------------------
# LATEST RECORDS PER COMPANY
# ---------------------------------------------------------

latest_ticks = pd.DataFrame()
latest_news = pd.DataFrame()

if not joined.empty and "ticker" in joined.columns:

    stock_data = joined.copy()

    if "market_event_time" in stock_data.columns:
        stock_data = stock_data.sort_values("market_event_time")

    latest_ticks = (
        stock_data.groupby("ticker", as_index=False)
        .tail(1)
        .sort_values("ticker")
    )

    news_data = joined.copy()

    if "article_id" in news_data.columns:
        news_data = news_data[
            news_data["article_id"].notna()
        ]

    if not news_data.empty:

        sort_column = (
            "news_state_timestamp"
            if "news_state_timestamp" in news_data.columns
            else "market_event_time"
        )

        if sort_column in news_data.columns:
            news_data = news_data.sort_values(sort_column)

        latest_news = (
            news_data.groupby("ticker", as_index=False)
            .tail(1)
            .sort_values("ticker")
        )


# ---------------------------------------------------------
# KPI METRICS
# ---------------------------------------------------------

st.subheader("Pipeline Overview")

c1, c2, c3, c4 = st.columns(4)

c1.metric("Silver News Events", f"{news_count:,}")
c2.metric("Silver Stock Ticks", f"{tick_count:,}")
c3.metric("Gold Enriched Records", f"{len(joined):,}")
c4.metric("Gold Window Records", f"{len(windowed):,}")


# ---------------------------------------------------------
# MARKET OVERVIEW
# ---------------------------------------------------------

tab1, tab2, tab3, tab4 = st.tabs([
    "Market Overview",
    "Latest News by Company",
    "Gold Enriched Records",
    "Window Analytics"
])


with tab1:

    st.subheader("Latest Stock Price and Sentiment")

    if not latest_ticks.empty:

        st.dataframe(
            latest_ticks[
                [
                    c for c in [
                        "ticker",
                        "current_price",
                        "change_percent",
                        "sentiment",
                        "sentiment_score",
                        "headline",
                        "market_event_time"
                    ]
                    if c in latest_ticks.columns
                ]
            ],
            use_container_width=True,
            hide_index=True
        )

        st.subheader("Latest Stock Prices")

        if {"ticker", "current_price"}.issubset(latest_ticks.columns):

            st.bar_chart(
                latest_ticks.set_index("ticker")["current_price"]
            )

    else:

        st.warning("Waiting for Gold enriched stock records.")


# ---------------------------------------------------------
# LATEST NEWS
# ---------------------------------------------------------

with tab2:

    st.subheader("Latest News and FinBERT Sentiment")

    if not latest_news.empty:

        for _, row in latest_news.iterrows():

            with st.container(border=True):

                st.markdown(f"### {row.get('ticker', 'Unknown')}")

                st.write(
                    row.get("headline") or "No headline available"
                )

                c1, c2 = st.columns(2)

                c1.metric(
                    "Sentiment",
                    str(row.get("sentiment", "N/A")).upper()
                )

                score = row.get("sentiment_score")

                c2.metric(
                    "Sentiment Score",
                    f"{float(score):.4f}"
                    if pd.notna(score) else "N/A"
                )

                st.caption(
                    f"Original publication: "
                    f"{row.get('news_event_time', 'N/A')}"
                )

                st.caption(
                    f"News state updated: "
                    f"{row.get('news_state_updated_at', 'N/A')}"
                )

    else:

        st.warning("No news-associated Gold records available yet.")


# ---------------------------------------------------------
# ENRICHED RECORDS
# ---------------------------------------------------------

with tab3:

    st.subheader("Stock Ticks with Latest News")

    if not joined.empty and "ticker" in joined.columns:

        tickers = sorted(joined["ticker"].dropna().unique())

        selected = st.selectbox(
            "Select Company",
            ["All Companies"] + tickers
        )

        filtered = joined.copy()

        if selected != "All Companies":
            filtered = filtered[filtered["ticker"] == selected]

        columns = [
            "tick_id",
            "ticker",
            "current_price",
            "change_percent",
            "article_id",
            "headline",
            "sentiment",
            "sentiment_score",
            "news_event_time",
            "market_event_time",
            "news_state_updated_at"
        ]

        st.dataframe(
            filtered[
                [c for c in columns if c in filtered.columns]
            ].tail(300),
            use_container_width=True,
            hide_index=True
        )

    else:

        st.warning("Waiting for Gold enriched records.")


# ---------------------------------------------------------
# WINDOW ANALYTICS
# ---------------------------------------------------------

with tab4:

    st.subheader("Five-Minute Stock Analytics")

    if not windowed.empty:

        st.dataframe(
            windowed.sort_values(
                "window_end",
                ascending=False
            ) if "window_end" in windowed.columns else windowed,
            use_container_width=True,
            hide_index=True
        )

        if {"ticker", "avg_price"}.issubset(windowed.columns):

            latest_windows = (
                windowed.sort_values("window_end")
                .groupby("ticker", as_index=False)
                .tail(1)
            )

            st.subheader("Average Stock Price")

            st.bar_chart(
                latest_windows.set_index("ticker")["avg_price"]
            )

        if {"ticker", "avg_sentiment_score"}.issubset(windowed.columns):

            latest_windows = (
                windowed.sort_values("window_end")
                .groupby("ticker", as_index=False)
                .tail(1)
            )

            st.subheader("Average Sentiment Score")

            st.bar_chart(
                latest_windows.set_index("ticker")[
                    "avg_sentiment_score"
                ]
            )

    else:

        st.warning(
            "Waiting for completed event-time windows. "
            "Append-mode output is delayed by the watermark."
        )


# ---------------------------------------------------------
# FOOTER
# ---------------------------------------------------------

st.divider()

st.caption(
    "FinTel Gold | Latest News Carry-Forward | "
    "Stock Tick Enrichment | Five-Minute Analytics"
)

st.caption("Dashboard refresh interval: 60 seconds.")

st_autorefresh(
    interval=60_000,
    key="gold_refresh"
)
