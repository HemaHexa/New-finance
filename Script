def new_slide(title=None, subtitle=None):
    slide = prs.slides.add_slide(prs.slide_layouts[6])
    slide.background.fill.solid()
    slide.background.fill.fore_color.rgb = BG

    # Top accent
    shape = slide.shapes.add_shape(
        MSO_SHAPE.RECTANGLE, 0, 0,
        prs.slide_width, Inches(0.09)
    )
    shape.fill.solid()
    shape.fill.fore_color.rgb = TEAL
    shape.line.fill.background()

    if title:
        add_text(slide, title, 0.65, 0.35, 12, 0.55,
                 27, NAVY, True)

    if subtitle:
        add_text(slide, subtitle, 0.68, 0.94, 12, 0.35,
                 11, GRAY)

    # Footer
    add_text(slide, "REAL-TIME FINANCIAL NEWS & MARKET STREAMING PIPELINE",
             0.65, 7.15, 10, 0.2, 8, GRAY)

    add_text(slide, f"{len(prs.slides):02d}",
             12.2, 7.12, 0.45, 0.25, 9, GRAY,
             align=PP_ALIGN.RIGHT)

    return slide


def add_text(slide, text, x, y, w, h, size=16,
             color=DARK, bold=False, align=PP_ALIGN.LEFT):
    box = slide.shapes.add_textbox(
        Inches(x), Inches(y), Inches(w), Inches(h)
    )
    tf = box.text_frame
    tf.word_wrap = True
    tf.margin_left = Inches(0.05)
    tf.margin_right = Inches(0.05)
    tf.margin_top = Inches(0.03)
    tf.margin_bottom = Inches(0.03)

    p = tf.paragraphs[0]
    p.alignment = align
    run = p.add_run()
    run.text = str(text)
    run.font.name = "Aptos"
    run.font.size = Pt(size)
    run.font.bold = bold
    run.font.color.rgb = color
    return box


def add_box(slide, x, y, w, h, title, body="",
            fill=WHITE, accent=BLUE, title_size=15,
            body_size=11):
    shape = slide.shapes.add_shape(
        MSO_SHAPE.ROUNDED_RECTANGLE,
        Inches(x), Inches(y), Inches(w), Inches(h)
    )
    shape.fill.solid()
    shape.fill.fore_color.rgb = fill
    shape.line.color.rgb = BORDER
    shape.line.width = Pt(1)

    # Accent bar
    bar = slide.shapes.add_shape(
        MSO_SHAPE.RECTANGLE,
        Inches(x), Inches(y), Inches(0.07), Inches(h)
    )
    bar.fill.solid()
    bar.fill.fore_color.rgb = accent
    bar.line.fill.background()

    add_text(slide, title, x+0.18, y+0.13, w-0.3, 0.35,
             title_size, NAVY, True)

    if body:
        add_text(slide, body, x+0.18, y+0.55, w-0.32,
                 h-0.62, body_size, GRAY)

    return shape


def add_arrow(slide, x1, y1, x2, y2, color=TEAL):
    line = slide.shapes.add_connector(
        MSO_CONNECTOR.STRAIGHT,
        Inches(x1), Inches(y1),
        Inches(x2), Inches(y2)
    )
    line.line.color.rgb = color
    line.line.width = Pt(2)
    line.line.end_arrowhead = True
    return line


def add_bullets(slide, items, x, y, w, h, size=16):
    box = slide.shapes.add_textbox(
        Inches(x), Inches(y), Inches(w), Inches(h)
    )
    tf = box.text_frame
    tf.word_wrap = True
    tf.margin_left = Inches(0.12)

    for i, item in enumerate(items):
        p = tf.paragraphs[0] if i == 0 else tf.add_paragraph()
        p.text = item
        p.level = 0
        p.font.name = "Aptos"
        p.font.size = Pt(size)
        p.font.color.rgb = DARK
        p.space_after = Pt(13)

    return box


def add_code_panel(slide, x, y, w, h, heading, code):
    shape = slide.shapes.add_shape(
        MSO_SHAPE.ROUNDED_RECTANGLE,
        Inches(x), Inches(y), Inches(w), Inches(h)
    )
    shape.fill.solid()
    shape.fill.fore_color.rgb = RGBColor(239, 243, 248)
    shape.line.color.rgb = BORDER

    add_text(slide, heading.upper(), x+0.18, y+0.12,
             w-0.35, 0.3, 10, TEAL, True)

    box = slide.shapes.add_textbox(
        Inches(x+0.18), Inches(y+0.52),
        Inches(w-0.35), Inches(h-0.65)
    )
    tf = box.text_frame
    tf.word_wrap = True
    tf.margin_left = 0
    tf.margin_right = 0

    p = tf.paragraphs[0]
    r = p.add_run()
    r.text = code
    r.font.name = "Consolas"
    r.font.size = Pt(10)
    r.font.color.rgb = DARK


def flow_row(slide, items, y, x=0.7, box_w=2.0, gap=0.55):
    for i, item in enumerate(items):
        bx = x + i * (box_w + gap)
        add_box(slide, bx, y, box_w, 0.9,
                item, "", LIGHT_BLUE, BLUE, 12)
        if i < len(items)-1:
            add_arrow(slide, bx+box_w+0.04, y+0.45,
                      bx+box_w+gap-0.05, y+0.45)


