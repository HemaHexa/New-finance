
"""FinTel Gold - Latest News Enrichment + Stock Window Aggregation."""

from __future__ import annotations

import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent

os.environ["PYSPARK_PYTHON"] = sys.executable
os.environ["PYSPARK_DRIVER_PYTHON"] = sys.executable

from pyspark.sql import SparkSession
from pyspark.sql import functions as F
from pyspark.sql.types import (
    StructType,
    StructField,
    StringType,
    DoubleType,
    BooleanType,
)


# ---------------------------------------------------------
# INPUT PATHS
# ---------------------------------------------------------

INPUT_TICKS = str(ROOT / "input" / "silver_ticks")


# ---------------------------------------------------------
# NEW OUTPUT PATHS
# Keep old Gold output untouched.
# ---------------------------------------------------------

JOINED_OUT = str(
    ROOT / "output" / "gold_joined_latest_news"
)

WINDOW_OUT = str(
    ROOT / "output" / "gold_windowed_latest_news"
)


# ---------------------------------------------------------
# NEW CHECKPOINT PATHS
# Do not reuse the old stream-stream join checkpoints.
# ---------------------------------------------------------

CHECKPOINT_JOIN = str(
    ROOT / "checkpoints" / "latest_news_gold_join"
)

CHECKPOINT_WINDOW = str(
    ROOT / "checkpoints" / "latest_news_gold_window"
)


# ---------------------------------------------------------
# ENRICHED STOCK TICK SCHEMA
# ---------------------------------------------------------

tick_schema = StructType([
    StructField("tick_id", StringType(), True),
    StructField("symbol", StringType(), True),

    StructField("current_price", DoubleType(), True),
    StructField("change", DoubleType(), True),
    StructField("change_percent", DoubleType(), True),

    StructField("currency", StringType(), True),
    StructField("source", StringType(), True),

    StructField("market_timestamp", StringType(), True),
    StructField("event_time", StringType(), True),

    StructField("latest_news_article_id", StringType(), True),
    StructField("latest_news_headline", StringType(), True),
    StructField("latest_news_sentiment", StringType(), True),
    StructField("latest_news_sentiment_score", DoubleType(), True),

    StructField("news_event_time", StringType(), True),
    StructField("latest_news_source", StringType(), True),
    StructField("news_state_updated_at", StringType(), True),

    StructField("has_latest_news", BooleanType(), True),
    StructField("is_mock", BooleanType(), True),
])


def main():

    # -----------------------------------------------------
    # CREATE DIRECTORIES
    # -----------------------------------------------------

    for path in [
        INPUT_TICKS,
        JOINED_OUT,
        WINDOW_OUT,
        CHECKPOINT_JOIN,
        CHECKPOINT_WINDOW,
    ]:
        Path(path).mkdir(parents=True, exist_ok=True)

    # -----------------------------------------------------
    # SPARK SESSION
    # -----------------------------------------------------

    spark = (
        SparkSession.builder
        .master("local[2]")
        .appName("FinTel-Gold-Latest-News-Enrichment")
        .config("spark.sql.shuffle.partitions", "2")
        .config("spark.sql.session.timeZone", "UTC")
        .config("spark.python.use.daemon", "false")
        .config("spark.pyspark.python", sys.executable)
        .config("spark.pyspark.driver.python", sys.executable)
        .config("spark.ui.showConsoleProgress", "false")
        .getOrCreate()
    )

    spark.sparkContext.setLogLevel("WARN")

    # -----------------------------------------------------
    # READ ENRICHED STOCK TICK STREAM
    # -----------------------------------------------------

    ticks = (
        spark.readStream
        .schema(tick_schema)
        .option("maxFilesPerTrigger", 100)
        .json(INPUT_TICKS)
        .withColumn(
            "market_event_time",
            F.to_timestamp("event_time")
        )
        .withColumn(
            "news_event_timestamp",
            F.to_timestamp("news_event_time")
        )
        .withColumn(
            "news_state_timestamp",
            F.to_timestamp("news_state_updated_at")
        )
        .filter(
            F.col("tick_id").isNotNull()
            & F.col("symbol").isNotNull()
            & F.col("market_event_time").isNotNull()
        )
    )

    # -----------------------------------------------------
    # GOLD ENRICHED OUTPUT
    #
    # One record per stock tick.
    # The adapter has already attached the latest news
    # available for that ticker.
    # -----------------------------------------------------

    enriched = ticks.select(
        F.col("tick_id"),
        F.upper(F.col("symbol")).alias("ticker"),

        F.col("current_price"),
        F.col("change"),
        F.col("change_percent"),
        F.col("currency"),
        F.col("source"),

        F.col("market_timestamp"),
        F.col("market_event_time"),

        F.col("latest_news_article_id").alias(
            "article_id"
        ),

        F.col("latest_news_headline").alias(
            "headline"
        ),

        F.col("latest_news_sentiment").alias(
            "sentiment"
        ),

        F.col("latest_news_sentiment_score").alias(
            "sentiment_score"
        ),

        F.col("news_event_time"),
        F.col("news_event_timestamp"),

        F.col("latest_news_source").alias(
            "news_source"
        ),

        F.col("news_state_updated_at"),
        F.col("news_state_timestamp"),

        F.coalesce(
            F.col("has_latest_news"),
            F.lit(False)
        ).alias("has_latest_news"),

        F.when(
            F.col("has_latest_news") == True,
            F.lit("LATEST_NEWS_ENRICHMENT")
        ).otherwise(
            F.lit("STOCK_ONLY")
        ).alias("gold_operation"),

        F.lit(False).alias("is_mock"),
    )

    # -----------------------------------------------------
    # QUERY 1: GOLD ENRICHED STOCK + LATEST NEWS
    # -----------------------------------------------------

    join_query = (
        enriched.writeStream
        .queryName("gold_latest_news_enrichment")
        .format("json")
        .outputMode("append")
        .option("path", JOINED_OUT)
        .option("checkpointLocation", CHECKPOINT_JOIN)
        .trigger(processingTime="2 seconds")
        .start()
    )

    # -----------------------------------------------------
    # QUERY 2: FIVE-MINUTE SLIDING WINDOW
    # -----------------------------------------------------

    window_input = (
        enriched
        .withWatermark(
            "market_event_time",
            "10 minutes"
        )
    )

    windowed = (
        window_input
        .groupBy(
            F.window(
                "market_event_time",
                "5 minutes",
                "1 minute"
            ),
            F.col("ticker")
        )
        .agg(
            F.count("*").alias("stock_tick_count"),

            F.avg("current_price").alias(
                "avg_price"
            ),

            F.min("current_price").alias(
                "min_price"
            ),

            F.max("current_price").alias(
                "max_price"
            ),

            F.avg("change_percent").alias(
                "avg_change_percent"
            ),

            F.avg(
                F.when(
                    F.col("has_latest_news") == True,
                    F.col("sentiment_score")
                )
            ).alias("avg_sentiment_score"),

            F.sum(
                F.when(
                    F.col("sentiment") == "positive",
                    1
                ).otherwise(0)
            ).alias("positive_tick_associations"),

            F.sum(
                F.when(
                    F.col("sentiment") == "negative",
                    1
                ).otherwise(0)
            ).alias("negative_tick_associations"),

            F.sum(
                F.when(
                    F.col("sentiment") == "neutral",
                    1
                ).otherwise(0)
            ).alias("neutral_tick_associations"),

            F.sum(
                F.when(
                    F.col("has_latest_news") == True,
                    1
                ).otherwise(0)
            ).alias("ticks_with_news"),

            F.sum(
                F.when(
                    F.col("has_latest_news") == False,
                    1
                ).otherwise(0)
            ).alias("ticks_without_news"),
        )
        .select(
            F.col("window.start").alias("window_start"),
            F.col("window.end").alias("window_end"),
            "ticker",
            "stock_tick_count",
            "avg_price",
            "min_price",
            "max_price",
            "avg_change_percent",
            "avg_sentiment_score",
            "positive_tick_associations",
            "negative_tick_associations",
            "neutral_tick_associations",
            "ticks_with_news",
            "ticks_without_news",
            F.lit(
                "5 minutes / 1 minute slide / 10 minutes watermark"
            ).alias("window_config"),
            F.lit(False).alias("is_mock"),
        )
    )

    # -----------------------------------------------------
    # WINDOW OUTPUT
    # -----------------------------------------------------

    window_query = (
        windowed.writeStream
        .queryName("gold_latest_news_sliding_window")
        .format("json")
        .outputMode("append")
        .option("path", WINDOW_OUT)
        .option("checkpointLocation", CHECKPOINT_WINDOW)
        .trigger(processingTime="2 seconds")
        .start()
    )

    # -----------------------------------------------------
    # STARTUP INFORMATION
    # -----------------------------------------------------

    print("\n" + "=" * 68, flush=True)
    print("FINTEL GOLD - LATEST NEWS ENRICHMENT", flush=True)
    print("=" * 68, flush=True)

    print("Input: Enriched Phase 2 Stock Silver ticks", flush=True)
    print("News: Latest available news per ticker", flush=True)
    print("Join: Stateful latest-news enrichment in adapter", flush=True)
    print("No repeated news publication required", flush=True)
    print("Original news and market timestamps preserved", flush=True)

    print("Gold processing trigger: 2 seconds", flush=True)
    print("Window size: 5 minutes", flush=True)
    print("Slide interval: 1 minute", flush=True)
    print("Watermark: 10 minutes", flush=True)

    print("Joined output:", JOINED_OUT, flush=True)
    print("Window output:", WINDOW_OUT, flush=True)

    print("=" * 68, flush=True)
    print("Gold streaming is running. Keep this terminal open.", flush=True)
    print("Press CTRL+C to stop.", flush=True)
    print("=" * 68, flush=True)

    # -----------------------------------------------------
    # KEEP STREAMS RUNNING
    # -----------------------------------------------------

    try:
        spark.streams.awaitAnyTermination()

    except KeyboardInterrupt:
        print("Stopping Gold streaming...", flush=True)

    finally:
        for query in spark.streams.active:
            query.stop()

        spark.stop()

        print("Gold Spark session stopped.", flush=True)


if __name__ == "__main__":
    main()
