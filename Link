    # --------------------------------------------------------
    # CONTINUOUS PRODUCER
    # --------------------------------------------------------

    def run(self):

        print("FinTel News Producer started.")

        print(f"Companies configured: {len(COMPANIES)}")
        print(
            f"RSS fetch interval: "
            f"{RSS_POLL_INTERVAL_SECONDS} seconds"
        )
        print(
            f"Latest snapshot interval: "
            f"{SNAPSHOT_PUBLISH_INTERVAL_SECONDS} seconds"
        )

        next_fetch = time.monotonic()
        next_snapshot = time.monotonic()

        try:

            while True:

                current_time = time.monotonic()

                # Fetch genuinely new RSS articles every 5 minutes.
                if current_time >= next_fetch:

                    try:
                        self.run_once()

                    except Exception as error:
                        print(f"[RSS CYCLE ERROR] {error}")

                    next_fetch = (
                        time.monotonic()
                        + RSS_POLL_INTERVAL_SECONDS
                    )

                # Publish the latest stored article every minute.
                if time.monotonic() >= next_snapshot:

                    try:
                        self.publish_latest_snapshot()

                    except Exception as error:
                        print(f"[SNAPSHOT ERROR] {error}")

                    next_snapshot = (
                        time.monotonic()
                        + SNAPSHOT_PUBLISH_INTERVAL_SECONDS
                    )

                time.sleep(1)

        except KeyboardInterrupt:

            print("\nStopping FinTel News Producer...")

        finally:

            self.kafka.close()

            print("FinTel News Producer stopped.")
