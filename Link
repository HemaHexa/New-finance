
-- 1. Bronze ingestion audit
CREATE TABLE IF NOT EXISTS bronze_ingestion_audit (
    run_id TEXT,
    job_name TEXT,
    topic TEXT,
    batch_id BIGINT,
    record_count BIGINT,
    status TEXT,
    latency_ms DOUBLE PRECISION,
    error_count BIGINT,
    error_message TEXT,
    recorded_at TIMESTAMPTZ DEFAULT NOW()
);

-- 2. Silver processing audit
CREATE TABLE IF NOT EXISTS silver_processing_audit (
    run_id TEXT,
    job_name TEXT,
    batch_id BIGINT,
    input_count BIGINT,
    processed_count BIGINT,
    rejected_count BIGINT,
    ticker_count BIGINT,
    duration_ms DOUBLE PRECISION,
    status TEXT,
    error_message TEXT,
    recorded_at TIMESTAMPTZ DEFAULT NOW()
);

-- 3. Gold aggregation audit
CREATE TABLE IF NOT EXISTS gold_aggregation_audit (
    run_id TEXT,
    job_name TEXT,
    batch_id BIGINT,
    window_start_min TIMESTAMPTZ,
    window_end_max TIMESTAMPTZ,
    input_news_count BIGINT,
    input_tick_count BIGINT,
    output_row_count BIGINT,
    late_records BIGINT,
    duration_ms DOUBLE PRECISION,
    status TEXT,
    error_message TEXT,
    recorded_at TIMESTAMPTZ DEFAULT NOW()
);

-- 4. Pipeline execution audit
CREATE TABLE IF NOT EXISTS pipeline_execution_audit (
    run_id TEXT PRIMARY KEY,
    job_name TEXT,
    started_at TIMESTAMPTZ,
    ended_at TIMESTAMPTZ,
    status TEXT,
    records_processed BIGINT,
    throughput_per_sec DOUBLE PRECISION,
    error_count BIGINT,
    last_error TEXT,
    heartbeat_at TIMESTAMPTZ
);
