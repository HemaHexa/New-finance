    # --------------------------------------------------------
    # PUBLISH LATEST NEWS SNAPSHOT
    # --------------------------------------------------------

    def publish_latest_snapshot(self):

        print("\n========== LATEST NEWS SNAPSHOT ==========")

        latest_news = load_latest_news()

        if not latest_news:
            print("[SNAPSHOT] No latest news available.")
            return

        published_count = 0

        for symbol, article in latest_news.items():

            if not isinstance(article, dict):
                continue

            success = self.kafka.publish_snapshot(
                symbol,
                article
            )

            if success:
                published_count += 1

        print(
            f"[SNAPSHOT COMPLETED] "
            f"{published_count}/{len(latest_news)} companies published."
        )
