                ]

            preferred_columns = [
                "tick_id",
                "ticker",
                "current_price",
                "change_percent",
                "article_id",
                "headline",
                "sentiment",
                "sentiment_score",
                "news_event_time",
                "market_event_time",
                "news_state_updated_at",
                "has_latest_news"
            ]

            available_columns = [
                col for col in preferred_columns
                if col in filtered.columns
            ]

            st.dataframe(
                filtered[available_columns].tail(300),
                use_container_width=True,
                hide_index=True
            )

    else:

        st.warning(
            "Waiting for Gold enriched records."
