        if "news_state_timestamp" in news_records.columns:

            news_records = news_records.sort_values(
                "news_state_timestamp"
            )

        elif "market_event_time" in news_records.columns:

            news_records = news_records.sort_values(
                "market_event_time"
            )

        latest_news = (
            news_records
            .groupby("ticker", as_index=False)
            .tail(1)
            .sort_values("ticker")
        )

        for _, row in latest_news.iterrows():

            ticker = row.get("ticker", "Unknown")
            headline = row.get("headline", "No headline")

            sentiment = row.get(
                "sentiment",
                "Not available"
            )

            score = row.get(
                "sentiment_score"
            )

            article_time = row.get(
                "news_event_time",
                "Not available"
            )

            updated_time = row.get(
                "news_state_updated_at",
                "Not available"
            )

            with st.container(border=True):

                st.markdown(f"### {ticker}")

                st.write(
                    headline or "No headline available"
                )

                col1, col2, col3 = st.columns(3)

                col1.metric(
                    "Sentiment",
                    str(sentiment).upper()
                )

                col2.metric(
                    "Sentiment Score",
                    (
                        f"{float(score):.4f}"
                        if pd.notna(score)
                        else "N/A"
                    )
                )

                col3.metric(
                    "Latest News Available",
                    "Yes"
                )

                st.caption(
                    f"Original publication time: {article_time}"
                )

