
from __future__ import annotations

import json
import time
import hashlib
from pathlib import Path
from datetime import datetime, timezone
from dateutil.parser import parse

import pyarrow.parquet as pq

from pyspark.sql import SparkSession
from delta import configure_spark_with_delta_pip


# ---------------------------------------------------------
# PATHS
# ---------------------------------------------------------

ROOT = Path(__file__).resolve().parent

STOCK_PATH = Path(
    r"C:\FinTel\Market_ticker\silver\data\stock_silver"
)

NEWS_PATH = Path(
    r"C:\FinTel\silver_news\data\silver\news_by_ticker"
)

NEWS_OUT = ROOT / "input" / "silver_news"
TICKS_OUT = ROOT / "input" / "silver_ticks"

STATE_DIR = ROOT / "checkpoints" / "real_upstream"
STATE_FILE = STATE_DIR / "processed.json"

POLL_SECONDS = 30


# ---------------------------------------------------------
# CREATE DIRECTORIES
# ---------------------------------------------------------

for folder in [NEWS_OUT, TICKS_OUT, STATE_DIR]:
    folder.mkdir(parents=True, exist_ok=True)


# ---------------------------------------------------------
# TIMESTAMP HELPERS
# ---------------------------------------------------------

def parse_event_time(value):
    if value is None:
        return None

    try:
        dt = parse(str(value).strip())

        if dt.tzinfo is None:
            dt = dt.replace(tzinfo=timezone.utc)

        return dt.astimezone(timezone.utc).isoformat()

    except Exception:
        return None


def timestamp_for_comparison(value):
    parsed = parse_event_time(value)

    if not parsed:
        return None

    return datetime.fromisoformat(parsed)


# ---------------------------------------------------------
# STATE MANAGEMENT
# ---------------------------------------------------------

def load_state():
    if STATE_FILE.exists():
        with open(STATE_FILE, "r", encoding="utf-8") as f:
            state = json.load(f)
    else:
        state = {}

    state.setdefault("tick_ids", [])
    state.setdefault("news_ids", [])
    state.setdefault("news_files", [])
    state.setdefault("latest_news", {})

    return state


def save_state(state):
    temp = STATE_FILE.with_suffix(".tmp")

    with open(temp, "w", encoding="utf-8") as f:
        json.dump(state, f, default=str)

    temp.replace(STATE_FILE)


# ---------------------------------------------------------
# FILE HELPERS
# ---------------------------------------------------------

def make_id(value):
    return hashlib.sha1(
        str(value).encode("utf-8")
    ).hexdigest()


def write_event(folder, key, record):
    filename = make_id(key) + ".json"
    target = folder / filename

    if target.exists():
        return

    temp = folder / (filename + ".tmp")

    with open(temp, "w", encoding="utf-8") as f:
        json.dump(record, f, default=str)

    temp.replace(target)


# ---------------------------------------------------------
# LATEST NEWS STATE
# ---------------------------------------------------------

def update_latest_news(latest_news, record):
    ticker = str(record.get("ticker") or "").upper()
    event_time = record.get("event_time")

    if not ticker or not event_time:
        return False

    new_time = timestamp_for_comparison(event_time)

    if new_time is None:
        return False

    existing = latest_news.get(ticker)

    if existing:
        old_time = timestamp_for_comparison(
            existing.get("news_event_time")
        )

        # Do not replace newer news with an older article.
        if old_time is not None and new_time <= old_time:
            return False

    latest_news[ticker] = {
        "article_id": record.get("article_id"),
        "headline": record.get("headline") or "",
        "sentiment": record.get("sentiment") or "neutral",
        "sentiment_score": record.get("sentiment_score"),
        "news_event_time": event_time,
        "source": record.get("source") or "",
        "news_state_updated_at": datetime.now(
            timezone.utc
        ).isoformat()
    }

    return True


def rebuild_latest_news(latest_news):
    """
    Restore the latest-news state from previously written
    Silver news adapter output files.

    This prevents losing the latest news after an adapter restart.
    """

    restored = 0

    for path in NEWS_OUT.glob("*.json"):
        try:
            with open(path, "r", encoding="utf-8") as f:
                record = json.load(f)

            if update_latest_news(latest_news, record):
                restored += 1

        except Exception as e:
            print(
                "Could not restore news state:",
                path.name,
                str(e)
            )

    print(
        f"Latest-news state restored. "
        f"Tickers available: {len(latest_news)} | "
        f"Updated during restoration: {restored}",
        flush=True
    )


def enrich_tick_with_latest_news(tick, latest_news):
    ticker = str(tick.get("symbol") or "").upper()

    news = latest_news.get(ticker)

    enriched = dict(tick)

    if news:
        enriched.update({
            "latest_news_article_id": news.get("article_id"),
            "latest_news_headline": news.get("headline"),
            "latest_news_sentiment": news.get("sentiment"),
            "latest_news_sentiment_score": news.get(
                "sentiment_score"
            ),
            "news_event_time": news.get("news_event_time"),
            "latest_news_source": news.get("source"),
            "news_state_updated_at": news.get(
                "news_state_updated_at"
            ),
            "has_latest_news": True
        })

    else:
        enriched.update({
            "latest_news_article_id": None,
            "latest_news_headline": None,
            "latest_news_sentiment": None,
            "latest_news_sentiment_score": None,
            "news_event_time": None,
            "latest_news_source": None,
            "news_state_updated_at": None,
            "has_latest_news": False
        })

    return enriched


# ---------------------------------------------------------
# SPARK / DELTA
# ---------------------------------------------------------

builder = (
    SparkSession.builder
    .appName("FinTel_Real_Silver_Adapter")
    .master("local[2]")
    .config("spark.driver.host", "127.0.0.1")
    .config("spark.driver.bindAddress", "127.0.0.1")
    .config("spark.sql.shuffle.partitions", "2")
    .config(
        "spark.sql.extensions",
        "io.delta.sql.DeltaSparkSessionExtension"
    )
    .config(
        "spark.sql.catalog.spark_catalog",
        "org.apache.spark.sql.delta.catalog.DeltaCatalog"
    )
)

spark = configure_spark_with_delta_pip(
    builder
).getOrCreate()

spark.sparkContext.setLogLevel("ERROR")


# ---------------------------------------------------------
# INITIALISE STATE
# ---------------------------------------------------------

state = load_state()

tick_ids = set(state["tick_ids"])
news_ids = set(state["news_ids"])
news_files = set(state["news_files"])

latest_news = state["latest_news"]

# Restore existing news state when upgrading from the old adapter.
if not latest_news:
    rebuild_latest_news(latest_news)

print("\n" + "=" * 65, flush=True)
print("FINTEL REAL SILVER ADAPTER - LATEST NEWS ENRICHMENT", flush=True)
print("=" * 65, flush=True)
print("Stock source:", STOCK_PATH, flush=True)
print("News source:", NEWS_PATH, flush=True)
print("Stock output:", TICKS_OUT, flush=True)
print("News output:", NEWS_OUT, flush=True)
print("Polling interval:", POLL_SECONDS, "seconds", flush=True)
print("Latest-news tickers:", len(latest_news), flush=True)
print("=" * 65, flush=True)


# ---------------------------------------------------------
# MAIN POLLING LOOP
# ---------------------------------------------------------

try:
    while True:

        new_ticks = 0
        new_news = 0
        latest_news_updates = 0
        ticks_with_news = 0
        ticks_without_news = 0

        # -------------------------------------------------
        # 1. READ NEW NEWS FIRST
        # -------------------------------------------------

        try:
            parquet_files = sorted(
                NEWS_PATH.rglob("*.parquet")
            )

            for file_path in parquet_files:

                file_key = str(file_path.resolve())

                if file_key in news_files:
                    continue

                try:
                    table = pq.read_table(file_path)
                    rows = table.to_pylist()

                    for row in rows:

                        article_id = row.get("article_id")
                        ticker = row.get("ticker")

                        headline = (
                            row.get("cleaned_headline")
                            or row.get("headline")
                        )

                        sentiment = row.get("sentiment")
                        sentiment_score = row.get(
                            "sentiment_score"
                        )

                        published_at = row.get("published_at")
                        event_time = parse_event_time(published_at)

                        if not article_id or not ticker or not event_time:
                            continue

                        ticker = str(ticker).upper()
                        unique_id = f"{article_id}|{ticker}"

                        output = {
                            "article_id": str(article_id),
                            "ticker": ticker,
                            "headline": headline or "",
                            "sentiment": sentiment or "neutral",
                            "sentiment_score": (
                                float(sentiment_score)
                                if sentiment_score is not None
                                else None
                            ),
                            "event_time": event_time,
                            "source": row.get("source") or "",
                            "is_mock": False
                        }

                        # Preserve unique article output.
                        if unique_id not in news_ids:

                            write_event(
                                NEWS_OUT,
                                unique_id,
                                output
                            )

                            news_ids.add(unique_id)
                            new_news += 1

                        # Update the latest-news state.
                        if update_latest_news(
                            latest_news,
                            output
                        ):
                            latest_news_updates += 1

                    news_files.add(file_key)

                except Exception as e:
                    print(
                        "News file read error:",
                        file_path.name,
                        str(e),
                        flush=True
                    )

        except Exception as e:
            print(
                "News directory error:",
                str(e),
                flush=True
            )

        # -------------------------------------------------
        # 2. READ STOCK SILVER AFTER UPDATING NEWS STATE
        # -------------------------------------------------

        try:
            stock_df = (
                spark.read
                .format("delta")
                .load(str(STOCK_PATH))
            )

            for row in stock_df.collect():

                record = row.asDict(recursive=True)

                tick_id = record.get("tick_id")
                symbol = record.get("symbol")

                market_time = parse_event_time(
                    record.get("market_timestamp")
                )

                unique_id = str(tick_id) if tick_id else (
                    f"{symbol}|{market_time}|"
                    f"{record.get('current_price')}"
                )

                if unique_id in tick_ids:
                    continue

                if not symbol or not market_time:
                    continue

                base_tick = {
                    "tick_id": unique_id,
                    "symbol": str(symbol).upper(),
                    "current_price": record.get("current_price"),
                    "change": record.get("change"),
                    "change_percent": record.get(
                        "change_percent"
                    ),
                    "currency": record.get("currency"),
                    "source": record.get("source"),
                    "market_timestamp": market_time,
                    "event_time": market_time,
                    "is_mock": False
                }

                # Attach the latest news for this ticker.
                enriched_tick = enrich_tick_with_latest_news(
                    base_tick,
                    latest_news
                )

                write_event(
                    TICKS_OUT,
                    unique_id,
                    enriched_tick
                )

                tick_ids.add(unique_id)
                new_ticks += 1

                if enriched_tick["has_latest_news"]:
                    ticks_with_news += 1
                else:
                    ticks_without_news += 1

        except Exception as e:
            print(
                "Stock read error:",
                str(e),
                flush=True
            )

        # -------------------------------------------------
        # 3. SAVE PERSISTENT STATE
        # -------------------------------------------------

        state = {
            "tick_ids": sorted(tick_ids),
            "news_ids": sorted(news_ids),
            "news_files": sorted(news_files),
            "latest_news": latest_news
        }

        save_state(state)

        # -------------------------------------------------
        # 4. LOG RESULTS
        # -------------------------------------------------

        print(
            f"\n[{datetime.now().strftime('%H:%M:%S')}] "
            f"New stock ticks: {new_ticks} | "
            f"New news records: {new_news} | "
            f"Latest-news updates: {latest_news_updates} | "
            f"Ticks with news: {ticks_with_news} | "
            f"Ticks without news: {ticks_without_news} | "
            f"Total tracked ticks: {len(tick_ids)} | "
            f"Total tracked news: {len(news_ids)} | "
            f"Tickers with latest news: {len(latest_news)}",
            flush=True
        )

        time.sleep(POLL_SECONDS)


except KeyboardInterrupt:
    print("\nAdapter stopped by user.", flush=True)

finally:
    spark.stop()
    print("Adapter Spark session stopped.", flush=True)
