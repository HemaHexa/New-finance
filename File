# ---------------------------------------------------------
# PATHS
# ---------------------------------------------------------

ROOT = Path(__file__).resolve().parent

JOINED_DIR = ROOT / "output" / "gold_joined_latest_news"
WINDOW_DIR = ROOT / "output" / "gold_windowed_latest_news"

NEWS_DIR = ROOT / "input" / "silver_news"
TICKS_DIR = ROOT / "input" / "silver_ticks"


# ---------------------------------------------------------
# PAGE CONFIGURATION
# ---------------------------------------------------------

st.set_page_config(
    page_title="FinTel | Gold Streaming",
    page_icon="📈",
    layout="wide"
)

st.title("FinTel — Real-Time Market Intelligence")

st.caption(
    "Latest News Carry-Forward · Stock Price Monitoring · "
    "Sentiment Analysis · Gold Streaming"
)


# ---------------------------------------------------------
# INFORMATION
# ---------------------------------------------------------

st.info(
    "The dashboard associates each new stock tick with the "
    "latest available news for its ticker. The original news "
    "publication timestamp is preserved. When a newer article "
    "arrives, subsequent ticks use that article."
)


# ---------------------------------------------------------
# READ JSON OUTPUT
# ---------------------------------------------------------

def read_json_dir(folder: Path) -> pd.DataFrame:

    paths = (
        list(folder.rglob("part-*.json"))
        if folder.exists()
        else []
    )

    frames = []

    for path in paths:

        try:
            if path.stat().st_size:
                frames.append(
                    pd.read_json(path, lines=True)
                )

        except (ValueError, OSError, json.JSONDecodeError):
            continue

    if not frames:
        return pd.DataFrame()

    return pd.concat(frames, ignore_index=True)


def count_json_events(folder: Path) -> int:

    paths = (
        list(folder.rglob("*.json"))
        if folder.exists()
        else []
    )

    count = 0

    for path in paths:

        try:
            if path.stat().st_size:
                count += len(
                    path.read_text(
                        encoding="utf-8"
                    ).splitlines()
                )

        except OSError:
            continue

    return count


# ---------------------------------------------------------
# LOAD DATA
# ---------------------------------------------------------

joined = read_json_dir(JOINED_DIR)
windowed = read_json_dir(WINDOW_DIR)

news_count = count_json_events(NEWS_DIR)
tick_count = count_json_events(TICKS_DIR)


